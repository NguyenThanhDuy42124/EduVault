# =============================================================================
# EduVault Backend - Cấu hình môi trường mẫu (.env.example)
# =============================================================================
# HƯỚNG DẪN SỬ DỤNG:
#   1. Copy file này thành .env:  copy .env.example .env
#   2. Điền các giá trị thực tế vào các biến bên dưới
#   3. KHÔNG bao giờ commit file .env lên Git (đã có trong .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# [1] MÔI TRƯỜNG ỨNG DỤNG
# -----------------------------------------------------------------------------
# Giá trị hợp lệ: development | staging | production
ENVIRONMENT=development

# Bật/tắt chế độ debug (chỉ dùng development). Giá trị: True | False
DEBUG=True

# Mức độ log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# [2] CƠ SỞ DỮ LIỆU MySQL (XAMPP / MariaDB)
# -----------------------------------------------------------------------------
# Địa chỉ host MySQL (thường là 127.0.0.1 khi chạy local)
MYSQL_HOST=127.0.0.1

# Cổng MySQL mặc định
MYSQL_PORT=3306

# Tên đăng nhập MySQL (XAMPP mặc định là root)
MYSQL_USER=root

# Mật khẩu MySQL (XAMPP mặc định để trống)
MYSQL_PASSWORD=

# Tên database (sẽ được tạo tự động bởi Alembic migration)
MYSQL_DATABASE=equipment_lending_db

# Connection string đầy đủ cho SQLAlchemy
# Cú pháp: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/equipment_lending_db

# -----------------------------------------------------------------------------
# [3] BẢO MẬT & XÁC THỰC JWT
# -----------------------------------------------------------------------------
# Khóa bí mật ký JWT - THAY BẰNG CHUỖI NGẪU NHIÊN ĐỦ MẠNH TRONG PRODUCTION!
# Tạo khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
# Tối thiểu 32 ký tự.
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_MIN_32_CHARS_IN_PRODUCTION

# Thuật toán ký JWT. Giá trị hợp lệ: HS256 | HS384 | HS512
JWT_ALGORITHM=HS256

# Thời gian hết hạn token (phút). 1440 = 24 giờ
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# [4] CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Danh sách các origin được phép gọi API (JSON array string)
# Development: thêm địa chỉ Vite dev server
# Production: thay bằng domain thực của frontend
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -----------------------------------------------------------------------------
# [5] BLOCKCHAIN - HARDHAT LOCAL NODE
# -----------------------------------------------------------------------------
# RPC URL của Hardhat node (chạy bằng: npx hardhat node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Chain ID của mạng Hardhat local (31337 là mặc định)
CHAIN_ID=31337

# Địa chỉ Smart Contract EquipmentLending sau khi deploy
# Chạy lại: cd contracts && npx hardhat run scripts/deploy.cjs --network localhost
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Private key của ví Admin Relayer (Account #0 Hardhat - CHỈ DÙNG CHO LOCAL!)
# !!! TUYỆT ĐỐI KHÔNG DÙNG PRIVATE KEY NÀY TRONG PRODUCTION !!!
# Production: Thay bằng private key ví thật trên mainnet/testnet
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Địa chỉ ví tương ứng với ADMIN_PRIVATE_KEY
ADMIN_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
