# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration (MySQL 8.x)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=equipment_lending_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/equipment_lending_db

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Blockchain Configuration (Pure Web3 Read-Only RPC Indexer & Receipt Verifier)
# Backend signs ZERO transactions; all state changes are signed in MetaMask by users.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
